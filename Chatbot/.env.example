# Copia este archivo como .env y llena tus datos. El .env nunca se sube a GitHub.

# Token del panel de Meta (WhatsApp > Configuración de la API > Generar token de acceso)
META_TOKEN=PEGA_AQUI_TU_TOKEN

# Phone Number ID del número de prueba
META_PHONE_NUMBER_ID=PEGA_AQUI_EL_PHONE_NUMBER_ID

# Contraseña que tú inventas; la misma va en "Verify token" del webhook en Meta
VERIFY_TOKEN=inventa_una_contrasena

# Clave secreta de la app de Meta (Configuración de la app > Básica > Clave secreta de la app).
# Sirve para comprobar que los mensajes del webhook vienen de Meta.
META_APP_SECRET=PEGA_AQUI_EL_APP_SECRET

# Clave que comparten el bot y el backend. Debe ser igual a Chatbot:ApiKey en los User Secrets del backend.
CHATBOT_API_KEY=inventa_una_clave_larga

# Dirección del backend (opcional; por defecto http://localhost:5080)
# BACKEND_URL=http://localhost:5080
