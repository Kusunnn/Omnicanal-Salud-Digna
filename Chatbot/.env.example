# Copia este archivo como .env y llena tus datos. El .env NO se sube a GitHub.

# Token de acceso de Meta (WhatsApp > Configuracion de la API > Generar token)
META_TOKEN=PEGA_AQUI_TU_TOKEN

# Identificador del numero de telefono (Phone Number ID) en Meta
META_PHONE_NUMBER_ID=PEGA_AQUI_EL_PHONE_NUMBER_ID

# Palabra que pones en Meta al configurar el webhook (Verify token)
VERIFY_TOKEN=elige_una_palabra

# Puerto del chatbot (el backend usa el 5080)
PORT=3000

# Opcional: si el backend esta corriendo, el bot lee de ahi el catalogo de servicios
# BACKEND_URL=http://localhost:5080
